<?xml version="1.0" encoding="utf-8"?>
<!--
  Nur für den github-Flavor (Sideload-APK aus GitHub-Releases). Der Play-Build darf
  sich nicht selbst aktualisieren — Permission und FileProvider fehlen dort deshalb
  komplett, statt nur zur Laufzeit deaktiviert zu sein.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- In-App-Update: heruntergeladene APK über den System-Installer installieren. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Teilt die heruntergeladene Update-APK content-URI-basiert mit dem System-Installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
